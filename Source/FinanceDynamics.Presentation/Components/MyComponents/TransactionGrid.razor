@using FinanceDynamics.Presentation.DTOs
@using System.Globalization
@inject ISnackbar Snackbar

<MudDataGrid @ref="DataGrid" Items="@TransactionList" SortMode="SortMode.Multiple"
    ColumnResizeMode="ResizeMode.Container">
    <Columns>
        <PropertyColumn Property="x => x.Id" Comparer="@(NaturalSortingEnabled ? new MudBlazor.Utilities.NaturalComparer() : null)" />
        <PropertyColumn Property="x => x.Value" Title="Valor" />
        <PropertyColumn Property="x => x.Category" Title="Categoria" />
        <PropertyColumn Property="x => x.SubCategory" Title="Categoria" />
        <PropertyColumn Property="x => x.TransactionMethod" Title="Método da transação" />
        <PropertyColumn Property="x => x.Date" Title="Data" />
        <PropertyColumn Property="x => x.Description" Title="Descrição" />
 
        <TemplateColumn CellClass="">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.FileOpen"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Title="Visualizar comprovante"
                               OnClick="@(async () => await ViewReceipt(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
 
        <TemplateColumn CellClass="">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Title="Editar"
                               OnClick="@(async () => await Edit(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
 
        <TemplateColumn CellClass="">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               Title="Excluir"
                               OnClick="@(async () => await Delete(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>

</MudDataGrid>

@code {
    [Parameter] public IEnumerable<TransactionDTO> TransactionList { get; init; } = [];

    private MudDataGrid<TransactionDTO> DataGrid = default!;
    private bool NaturalSortingEnabled = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await DataGrid.SetSortAsync(
                nameof(TransactionDTO.Id), 
                SortDirection.Ascending, 
                x => x.Id, 
                NaturalSortingEnabled ? new MudBlazor.Utilities.NaturalComparer() : null
            );
        }
    }

    private Task ViewReceipt(TransactionDTO transactionDTO)
    {
        Snackbar.Add($"Comprovante: #{transactionDTO.GuidId}", Severity.Normal);
        return Task.CompletedTask;
    }

    private Task Edit(TransactionDTO transactionDTO)
    {
        Snackbar.Add($"Editar: #{transactionDTO.GuidId}", Severity.Info);
        return Task.CompletedTask;
    }

    private Task Delete(TransactionDTO transactionDTO)
    {
        Snackbar.Add($"Excluir: #{transactionDTO.GuidId}", Severity.Warning);
        return Task.CompletedTask;
    }
}