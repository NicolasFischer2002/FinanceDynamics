@using FinanceDynamics.Application.Interfaces
@using FinanceDynamics.Presentation.DTOs
@using System.Globalization
@using Domain.Enums
@inject ISnackbar Snackbar
@inject ITransactionReceiptService ITransactionReceiptService
@inject IJSRuntime JS
@inject IDialogService DialogService

<MudDataGrid @ref="DataGrid" Items="@TransactionList" SortMode="SortMode.Multiple"
             ColumnResizeMode="ResizeMode.None">
    <Columns>
        <PropertyColumn Property="x => x.Id" Comparer="@(NaturalSortingEnabled ? new MudBlazor.Utilities.NaturalComparer() : null)" />
        <PropertyColumn Property="x => x.Value" Title="Valor" />
        <PropertyColumn Property="x => x.Category" Title="Categoria" />
        <PropertyColumn Property="x => x.SubCategory" Title="Subcategoria" />
        <PropertyColumn Property="x => x.TransactionMethod" Title="Método da transação" />
        <PropertyColumn Property="x => x.Date" Title="Data" />
        <PropertyColumn Property="x => x.Description" Title="Descrição" />

        <TemplateColumn CellClass="">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Title="Editar"
                               @onclick="@(async () => await ManageFiles(context.Item))">
                </MudIconButton>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn CellClass="">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Title="Deletar registro"
                               @onclick="@(async () => await DeleteTransaction(context.Item))">
                </MudIconButton>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    [Parameter, EditorRequired]
    public IEnumerable<TransactionDTO> TransactionList { get; init; } = [];

    [Parameter, EditorRequired]
    public required TransactionType TransactionType { get; init; }

    private MudDataGrid<TransactionDTO> DataGrid = default!;
    private bool NaturalSortingEnabled = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await DataGrid.SetSortAsync(
                nameof(TransactionDTO.Id), 
                SortDirection.Ascending, 
                x => x.Id, 
                NaturalSortingEnabled ? new MudBlazor.Utilities.NaturalComparer() : null
            );
        }
    }

    private async Task ManageFiles(TransactionDTO transactionDTO)
    {
        var parameters = new DialogParameters<MyDialogManageFiles>
        {
            { x => x.IdTransaction, transactionDTO.GuidId },
            { x => x.TransactionType, TransactionType }
        };

        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var teste = DialogService.ShowAsync<MyDialogManageFiles>("Gerenciar Comprovante", parameters, options);
    }

    private async Task DeleteTransaction(TransactionDTO transactionDTO)
    {
        Snackbar.Add($"Registro deletado com sucesso!", Severity.Success);
    }
}