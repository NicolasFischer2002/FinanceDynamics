@code {
    [Parameter]
    public string Title { get; set; } = "Default Title";

    [Parameter]
    public string Content { get; set; } = "Default Content";

    [Parameter]
    public string BackgroundColor { get; set; } = "";

    [Parameter]
    public string TextColor { get; set; } = "";
}

<MudCard Style="@($"background-color: {BackgroundColor};")">
    <MudCardContent>
        <MudText Style="@($"color: {TextColor};")" Typo="Typo.body1">@Title</MudText>
        <MudText Style="@($"color: {TextColor};")" Align="Align.Right" Typo="Typo.h6">@Content</MudText>
    </MudCardContent>
</MudCard>