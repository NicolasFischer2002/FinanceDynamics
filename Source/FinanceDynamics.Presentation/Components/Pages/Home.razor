@page "/"
@using FinanceDynamics.Presentation.Components.MyComponents
@using FinanceDynamics.Application.Interfaces
@using FinanceDynamics.Application.Services
@inject IIncomeRepository IIncomeRepository
@inject IExpenseRepository IExpenseRepository
@inject IFinancialStatement IFinancialStatement

<PageTitle>Home</PageTitle>

<MudGrid Justify="Justify.Center" Spacing="2">
    <MudItem xs="12" sm="4" md="4">
        <CustomCard Title="Receitas" Content="@IncomeDisplay" BackgroundColor="#72AC54" TextColor="#FFFFFF" />
    </MudItem>
    <MudItem xs="12" sm="4" md="4">
        <CustomCard Title="Despesas" Content="@ExpenseDisplay" BackgroundColor="#5695EF" TextColor="#FFFFFF" />
    </MudItem>
    <MudItem xs="12" sm="4" md="4">
        <CustomCard Title="Saldo" Content="@Balance" BackgroundColor="#E7971C" TextColor="#FFFFFF" />
    </MudItem>
</MudGrid>

<MudPaper Class="pa-4 mt-8">
    <MudText Align="Align.Center" Typo="Typo.h6">Receitas</MudText>
    <MudChart Class="mt-4" ChartType="ChartType.Pie" InputData="@IncomeData" InputLabels="@IncomeLabels" Width="300px" Height="300px" />
</MudPaper>
<MudPaper Class="pa-4 mt-8">
    <MudText Align="Align.Center" Typo="Typo.h6">Despesas</MudText>
    <MudChart Class="mt-4" ChartType="ChartType.Pie" InputData="@ExpenseData" InputLabels="@ExpenseLabels" Width="300px" Height="300px" />
</MudPaper>

@code {
    private double[] IncomeData = [2000, 4000, 4000];
    private string[] IncomeLabels = ["Salário", "Devolução", "Dividendos"];

    private double[] ExpenseData = [2000, 2000, 2000];
    private string[] ExpenseLabels = ["Transporte", "Alimentação", "Lazer"];

    private string IncomeDisplay = "R$ 0,00";
    private string ExpenseDisplay = "R$ 0,00";
    private string Balance = "R$ 0,00";

    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Today;
        var startOfMonth = new DateTime(today.Year, today.Month, 1);
        var endOfMonth = startOfMonth.AddMonths(1).AddDays(-1);

        var range = new FinanceDynamics.Application.ValueObjects.DateRange(startOfMonth, endOfMonth);

        await LoadTotalIncome(range);
        await LoadTotalExpense(range);
        await LoadBalance(range);
    }

    public async Task LoadTotalIncome(FinanceDynamics.Application.ValueObjects.DateRange range)
    {
        decimal totalIncome = await IIncomeRepository.GetIncomeValueByDateRange(range);
        IncomeDisplay = MoneyFormatter.Format(totalIncome);
    }

    public async Task LoadTotalExpense(FinanceDynamics.Application.ValueObjects.DateRange range)
    {
        decimal totalExpense = await IExpenseRepository.GetExpenseValueByDateRange(range);
        ExpenseDisplay = MoneyFormatter.Format(totalExpense);
    }

    public async Task LoadBalance(FinanceDynamics.Application.ValueObjects.DateRange range)
    {
        decimal balance = await IFinancialStatement.BalanceBetweenDates(range);
        Balance = MoneyFormatter.Format(balance);
    }
}