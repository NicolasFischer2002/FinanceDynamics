@page "/ViewExpenses"
@using FinanceDynamics.Domain.Enums
@using FinanceDynamics.Presentation.Components.MyComponents
@using FinanceDynamics.Domain.Entities
@using FinanceDynamics.Application.Interfaces
@using FinanceDynamics.Presentation.DTOs
@inject IExpenseRepository IIExpenseRepository

<PageTitle>Consultar despesas</PageTitle>

<MyDateRange DateRange="@_dateRange"
             DateRangeChanged="OnDateRangeChanged" />

<MudText Typo="Typo.h6" GutterBottom="true">Consultar despesas</MudText>

<TransactionGrid TransactionList="@Expenses" TransactionType="TransactionType.Expense"></TransactionGrid>

@code {
    private DateRange? _dateRange;
    private List<TransactionDTO> Expenses { get; set; } = new List<TransactionDTO>();

    protected override async Task OnInitializedAsync() 
    {
        var today = DateTime.Today;
        var startOfMonth = new DateTime(today.Year, today.Month, 1);
        var endOfMonth = startOfMonth.AddMonths(1).AddDays(-1);

        var range = new FinanceDynamics.Application.ValueObjects.DateRange(startOfMonth, endOfMonth);
        await FillInTransactionList(range);
    }

    private async Task OnDateRangeChanged(DateRange? range)
    {
        _dateRange = range;

        if (_dateRange?.Start is null || _dateRange?.End is null)
            return;

        var newRange = new FinanceDynamics.Application.ValueObjects.DateRange(_dateRange.Start.Value, _dateRange.End.Value);

        await FillInTransactionList(newRange);
    }

    private async Task FillInTransactionList(FinanceDynamics.Application.ValueObjects.DateRange range)
    {
        IReadOnlyList<Expense>? expenses = await IIExpenseRepository.GetExpenseByDateRange(range);

        if (expenses is null || expenses.Count == 0)
        {
            Expenses = new List<TransactionDTO>();
            return;
        }

        Expenses = expenses
            .Select((tl, index ) => new TransactionDTO(
                index + 1,
                tl.Id,
                tl.Value.GetValue(),
                tl.Category.Name,
                tl.Subcategory?.Name ?? string.Empty,
                tl.Method.ToString(),
                tl.Date,
                tl.Description?.ToString()
            )).ToList();
    }
}