@page "/AddIncome"
@using System.Globalization
@using System.Threading
@using FinanceDynamics.Application.Interfaces
@using FinanceDynamics.Domain.Entities
@using FinanceDynamics.Domain.Enums
@using FinanceDynamics.Domain.ValueObjects
@using FinanceDynamics.Presentation.Components.MyComponents
@using FinanceDynamics.Domain.Exceptions
@inject ISnackbar Snackbar
@inject IIncomeFactory IIncomeFactory
@inject IIncomeRepository IIncomeRepository

<PageTitle>Adicionar receita</PageTitle>

<MudText Typo="Typo.h6" GutterBottom="true" Class="d-flex align-items-center">
    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet"
             Size="Size.Medium"
             Class="me-3 align-self-center" />
    Adicionar receita
</MudText>

<MudGrid>
    <MudItem xs="4">
        <MudPaper Class="d-flex align-center justify-center mud-width-full pa-4">
            <MudNumericField Immediate="false"
                             Label="Valor em reais"
                             Format="C2"
                             Culture="@_ptBR"
                             T="decimal?"
                             @bind-Value="_valueBr" />
        </MudPaper>
    </MudItem>
    <MudItem xs="4">
        <CategorySelect Kind="TransactionType.Income"
                        Label="Categoria"
                        @bind-Value="Category" />
    </MudItem>
    <MudItem xs="4">
        <SubcategorySelect 
          Kind="TransactionType.Income"
          ParentCategory="@Category"    
          Label="Subcategoria"
          @bind-Value="Subcategory" />
    </MudItem>
    <MudItem xs="6">
        <TransactionMethodSelect @bind-Value="PaymentMethod" />
    </MudItem>
    <MudItem xs="6">
        <MudPaper Class="d-flex align-center justify-center mud-width-full pa-4">
            <MudDatePicker Label="Data" @bind-Date="Date" />
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <TransactionDescriptionInput Label="Observações"
                  MaxLength="150"
                  HelperText="Campo opcional"
                  @bind-Value="Description" />
    </MudItem>
    <MudItem xs="12">
        <FileUploader @ref="_fileUploader"
                      FilesChanged="OnFilesUpdated" />
    </MudItem>
</MudGrid>

<MudButton Class="mt-6" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="Add">Cadastrar</MudButton>

@code {
    private readonly CultureInfo _ptBR = CultureInfo.GetCultureInfo("pt-BR");
    private decimal? _valueBr = 0M;

    private string _category = string.Empty;
    public string Category
    {
        get => _category;
        set
        {
            if (_category != value)
            {
                _category = value;
                Subcategory = string.Empty;
            }
        }
    }

    private string Subcategory { get; set; } = string.Empty;
    private string PaymentMethod { get; set; } = string.Empty;

    private DateTime? Date = DateTime.Today;

    private FileUploader? _fileUploader;

    private void OnFilesUpdated(List<IBrowserFile> files)
    {

    }

    private string Description { get; set; } = string.Empty;

    private async Task Add()
    {
        try
        {
            decimal value = _valueBr ?? 0m;
            TransactionReceipt? transactionReceipt = _fileUploader is not null ? await _fileUploader.GetReceiptAsync() : null;

            Income income = IIncomeFactory.Create(
                value,
                Category, 
                Subcategory, 
                PaymentMethod, 
                DateTime.Now, 
                Description,
                transactionReceipt
            );
            
            await IIncomeRepository.AddAsync(income);

            Snackbar.Clear();
            Snackbar.Add($"Adicionado com sucesso!", Severity.Success);
        }
        catch (DomainException ex)
        {
            Snackbar.Clear();
            Snackbar.Add($"{ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Clear();
            Snackbar.Add($"Erro inesperado: {ex.Message}", Severity.Error);
        }
    }
}